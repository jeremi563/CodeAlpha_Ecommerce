@baseUrl = http://localhost:5000

### Health check
GET {{baseUrl}}/api/health

### List active products (Phase 3)
GET {{baseUrl}}/api/products

### Create a product (Phase 3, admin only)
# Run this before the product detail, update, cart, and order requests.
# Create an admin account by promoting a registered user in PostgreSQL, then log in below.
# Registration deliberately does not allow clients to choose the admin role.
# @name createProduct
POST {{baseUrl}}/api/products
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
	"name": "Canvas Backpack",
	"description": "A durable everyday backpack with a padded laptop sleeve.",
	"price": 3499.99,
	"stock": 12,
	"imageUrl": "https://example.com/images/canvas-backpack.jpg"
}

### Get the product created above (Phase 3)
GET {{baseUrl}}/api/products/{{createProduct.response.body.$.id}}

### Update the product stock (Phase 3, admin only)
PATCH {{baseUrl}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
	"stock": 10,
	"price": 3299.99
}

### Invalid product payload example (Phase 3, expect 400)
POST {{baseUrl}}/api/products
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
	"name": "Invalid product",
	"price": -10
}

### Register a customer (Phase 4)
# Use a new email if you have already registered this address.
# @name registerCustomer
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
	"name": "Jordan Customer",
	"email": "jordan.customer@example.com",
	"password": "StorePass123!"
}
###
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "name":"admin",
	"email": "admin@example.com",
	"password": "ReplaceWithAdminPassword123!"
}

### Log in as a customer (Phase 4)
# @name loginCustomer
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
	"email": "jordan.customer@example.com",
	"password": "StorePass123!"
}

### Try an incorrect password (Phase 4, expect 401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
	"email": "jordan.customer@example.com",
	"password": "WrongPassword123!"
}

### Get the current customer (Phase 4)
GET {{baseUrl}}/api/auth/me
Authorization: Bearer {{loginCustomer.response.body.$.token}}

### Log in as an admin (Phase 4)
# This account must already exist and have role ADMIN in the database.
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
	"email": "admin@example.com",
	"password": "ReplaceWithAdminPassword123!"
}

### Add the created product to the cart (Phase 5)
# Adding the same product again increases its existing cart quantity.
POST {{baseUrl}}/api/cart
Authorization: Bearer {{loginCustomer.response.body.$.token}}
Content-Type: application/json

{
	"productId": "{{createProduct.response.body.$.id}}",
	"quantity": 2
}

### View the customer's cart (Phase 5)
GET {{baseUrl}}/api/cart
Authorization: Bearer {{loginCustomer.response.body.$.token}}

### Set the cart quantity (Phase 5)
# PATCH sets the quantity to this value; it does not add to the current quantity.
PATCH {{baseUrl}}/api/cart/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginCustomer.response.body.$.token}}
Content-Type: application/json

{
	"quantity": 1
}

### Remove this product from the cart (Phase 5)
DELETE {{baseUrl}}/api/cart/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginCustomer.response.body.$.token}}

### Clear the cart (Phase 5)
DELETE {{baseUrl}}/api/cart
Authorization: Bearer {{loginCustomer.response.body.$.token}}

### Place an order from the customer's cart (Phase 6)
# The server calculates totals and snapshots product names and prices from the database.
# @name placeOrder
POST {{baseUrl}}/api/orders
Authorization: Bearer {{loginCustomer.response.body.$.token}}

### Add the test product for M-Pesa payment (Phase 9)
# Run this before creating the M-Pesa test order. The earlier cart examples clear the cart.
POST {{baseUrl}}/api/cart
Authorization: Bearer {{loginCustomer.response.body.$.token}}
Content-Type: application/json

{
	"productId": "{{createProduct.response.body.$.id}}",
	"quantity": 1
}

### Create an order to pay for with M-Pesa (Phase 9)
# In live mode, use this order ID for the STK request. The server uses its stored total.
# @name createMpesaOrder
POST {{baseUrl}}/api/orders
Authorization: Bearer {{loginCustomer.response.body.$.token}}

### Send an M-Pesa STK push (Phase 9)
# With MPESA_ENABLED=false this returns a sandbox simulation and sends no real prompt.
# With MPESA_ENABLED=true, Safaricom sends an STK prompt to the phone number below.
# @name mpesaStkPush
POST {{baseUrl}}/api/payments/mpesa/stk-push
Authorization: Bearer {{loginCustomer.response.body.$.token}}
Content-Type: application/json

{
	"orderId": "{{createMpesaOrder.response.body.$.order.id}}",
	"phone": "254712345678",
	"amount": "{{createMpesaOrder.response.body.$.order.total}}",
	"accountReference": "NEXORA-TEST",
	"transactionDesc": "Test order payment"
}

### M-Pesa callback route smoke test (Phase 9)
# This unknown request ID is acknowledged but cannot change an order or payment.
# For live mode, append ?token={{mpesaCallbackToken}} and set that REST Client variable locally.
POST {{baseUrl}}/api/payments/mpesa/callback
Content-Type: application/json

{
	"Body": {
		"stkCallback": {
			"CheckoutRequestID": "unmatched-rest-smoke-test",
			"ResultCode": 0,
			"ResultDesc": "Smoke test callback"
		}
	}
}

### Invalid M-Pesa phone example (expect 400)
POST {{baseUrl}}/api/payments/mpesa/stk-push
Authorization: Bearer {{loginCustomer.response.body.$.token}}
Content-Type: application/json

{
	"phone": "254700581291",
	"amount": 2000
}

### List the customer's orders (Phase 6)
GET {{baseUrl}}/api/orders
Authorization: Bearer {{loginCustomer.response.body.$.token}}

### Get the order created above (Phase 6)
GET {{baseUrl}}/api/orders/{{placeOrder.response.body.$.id}}
Authorization: Bearer {{loginCustomer.response.body.$.token}}

### List all orders (admin, Phase 6)
GET {{baseUrl}}/api/admin/orders
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### Update the order status (admin, Phase 6)
PATCH {{baseUrl}}/api/admin/orders/{{placeOrder.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}
Content-Type: application/json

{
	"status": "PROCESSING"
}

### Delete the test product (Phase 3, admin only)
# Run this last. It will fail with 409 if an order references the product.
DELETE {{baseUrl}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}