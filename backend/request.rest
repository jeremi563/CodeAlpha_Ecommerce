@baseUrl = http://localhost:5000
@adminToken = replace-with-an-admin-jwt
@customerToken = replace-with-a-customer-jwt

### Health check
GET {{baseUrl}}/api/health

### List active products (Phase 3)
GET {{baseUrl}}/api/products

### Create a product (Phase 3, admin only)
# Run this before the product detail, update, cart, and order requests.
# Replace @adminToken with a valid JWT containing role: "ADMIN".
# @name createProduct
POST {{baseUrl}}/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"name": "Canvas Backpack",
	"description": "A durable everyday backpack with a padded laptop sleeve.",
	"price": 3499.99,
	"stock": 12,
	"imageUrl": "https://example.com/images/canvas-backpack.jpg"
}

### Get the product created above (Phase 3)
GET {{baseUrl}}/api/products/{{createProduct.response.body.$.id}}

### Update the product stock (Phase 3, admin only)
PATCH {{baseUrl}}/api/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"stock": 10,
	"price": 3299.99
}

### Invalid product payload example (Phase 3, expect 400)
POST {{baseUrl}}/api/products
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
	"name": "Invalid product",
	"price": -10
}

