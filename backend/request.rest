DELETE {{baseUrl}}/api/cart
Authorization: Bearer {{customerToken}}

### Place an order from the customer's cart (Phase 6, not implemented yet)
# The server should calculate totals from the cart; do not send a client total.
# @name placeOrder
POST {{baseUrl}}/api/orders
Authorization: Bearer {{customerToken}}

### List the customer's orders (Phase 6, not implemented yet)
